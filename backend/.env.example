# Copy to .env and adjust. Defaults work out of the box for local dev.

# SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/waypoint
DATABASE_URL=sqlite:///./waypoint.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=10080

# Where the FRONTEND runs; used to build the share links that go in QR codes.
PUBLIC_BASE_URL=http://localhost:5173

# The absolute origin of THIS api, e.g. https://waypoint-api.onrender.com.
#
# Photos are stored as relative paths (/uploads/x.jpg). That only resolves
# correctly when the site and the API share an origin. On a split deploy —
# frontend on Vercel, API here — leave this set, or every photo 404s because the
# browser looks for /uploads/... on the site's own origin.
#
# Leave EMPTY for local dev (Vite proxies it) and for the single-container
# deploy, where both are the same origin anyway.
PUBLIC_API_BASE=

# Path to the built frontend (`npm run build` in ../frontend).
#
# Unset in dev, where Vite serves the frontend. Set it to have this one process
# serve both the API and the site, which gives you a single public URL and no
# CORS to configure:
#
#   STATIC_DIR=../frontend/dist
STATIC_DIR=

# Populate the demo account and sample routes on boot when the database is
# empty. Safe to leave on: it only runs against an empty database.
SEED_DEMO_DATA=true

# Let anyone sign in as the demo account without typing credentials.
# Turn OFF for anything real.
DEMO_AUTO_LOGIN=true

# Landmark re-verification window (PRD: six months).
VERIFICATION_DAYS=180

MAX_UPLOAD_BYTES=8388608

# Only needed on a split deploy, where the browser sends cross-origin requests.
# A single-container deploy serves everything from one origin and ignores this.
# Accepts a JSON array or a plain comma-separated list.
#   CORS_ORIGINS=https://waypoint.vercel.app
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]