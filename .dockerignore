# Keep the build context small and never bake secrets or local data into the image.
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

.git
.gitignore
*.md
!README.md

# Local state — the container creates its own on the volume.
backend/.env
backend/.env.local
backend/landmarkx.db
backend/landmarkx.db-journal
backend/uploads/*
!backend/uploads/.gitkeep

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db
*.log
