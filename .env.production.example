# Production environment for a single-container deploy.
# Copy to .env.production and fill in, or set these as secrets in your host.

# Where the app will be reachable. Used to build share links and QR codes, so
# it must be the real public URL or every shared link points at localhost.
PUBLIC_BASE_URL=https://waypoint.example.com

# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# SQLite on the mounted volume. Both of these must live on the volume or data
# is lost on every deploy.
DATABASE_URL=sqlite:////data/waypoint.db
UPLOAD_DIR=/data/uploads

# Demo account + sample routes are created on first boot.
SEED_DEMO_DATA=true

# Sign visitors into the demo account automatically, so nobody hits a login
# wall. Great for a hackathon demo; turn OFF for anything real.
DEMO_AUTO_LOGIN=true

# Landmark re-verification window, in days (PRD says six months).
VERIFICATION_DAYS=180

# Only needed if you serve the frontend from a different origin. With a
# single-container deploy the site and API share an origin, so CORS is off.
# CORS_ORIGINS=["https://waypoint.example.com"]
